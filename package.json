{
  "name": "rpgm-cheat-tool",
  "version": "1.0.0",
  "description": "Hack any RPG Maker MV/MZ game in 1 click",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win portable",
    "build-installer": "electron-builder --win nsis"
  },
  "author": "RPGM Cheat Tool",
  "license": "MIT",
  "type": "commonjs",
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.rpgm.cheattool",
    "productName": "RPGM Cheat Tool",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "style.css",
      "script.js",
      "rpgm-cheat-engine.js"
    ],
    "win": {
      "target": [
        "portable"
      ]
    },
    "portable": {
      "artifactName": "RPGM-Cheat-Tool.exe"
    }
  }
}
